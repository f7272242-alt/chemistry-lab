# Local development only. Never commit or share a real API key.
AI_API_KEY=PASTE_YOUR_NEW_API_KEY_HERE
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_SERVER_PORT=3001
# Optional: comma-separated allowed browser origins when frontend and API use different domains.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Optional for a separately hosted API; leave empty for same-domain deployment.
VITE_AI_API_URL=
